# Convex
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Local Next always runs on http://localhost:59316 (`pnpm dev`).
# Production canonical origin is https://www.travelcalendar.space.
# ourcalendar.space and www.ourcalendar.space 308 there (path and query kept).
# Convex deployment env (npx convex env set ...):
#   local:  SITE_URL=http://localhost:59316
#   prod:   SITE_URL=https://www.travelcalendar.space
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_RESEND_KEY=
# JWT_PRIVATE_KEY=   (via npx @convex-dev/auth)
# JWKS=

# Covers + Mara
PEXELS_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=google/gemini-2.5-flash-lite

# Paywall (optional — enable for prod / agent billing)
# Same Payment Link base on Next + Convex (Convex enforces access):
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/…
# npx convex env set STRIPE_PAYMENT_LINK "https://buy.stripe.com/…"
# npx convex env set STRIPE_WEBHOOK_SECRET "whsec_…"
# npx convex env set BYPASS_CODES "CODE1,CODE2"
# Stripe webhook URL: https://<deployment>.convex.site/stripe/webhook

# Agent MCP (local; not Next.js — set in Cursor MCP env)
# TRAVEL_CALENDAR_SITE_URL=https://<deployment>.convex.site
# TRAVEL_CALENDAR_API_KEY=tc_…
